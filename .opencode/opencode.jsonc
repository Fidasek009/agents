{
  "$schema": "https://opencode.ai/config.json",
  "model": "e-infra/kimi-k3",
  "small_model": "e-infra/qwen3.8-27b",
  "agent": {
    "build": {
      "model": "e-infra/kimi-k3",
      "variant": "max"
    },
    "title": {
      "model": "e-infra/qwen3.8-27b"
    },
    "summary": {
      "model": "e-infra/qwen3.8-27b"
    },
    "compaction": {
      "model": "e-infra/qwen3.8-flash-next"
    }
  },
  "plugin": [
    "opencode-wakatime",
    "opencode-rules@latest"
  ],
  "mcp": {
    "searxng": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "mcp-searxng"],
      "environment": {
        "SEARXNG_URL": "https://searx.salonek.org"
      }
    },
    "context7": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@upstash/context7-mcp"]
    }
  },
  "provider": {
    "e-infra": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "E-INFRA",
      "options": {
        "baseURL": "https://llm.ai.e-infra.cz/v1"
      },
      "models": {
        "kimi-k3": {
          "name": "Kimi K3",
          "family": "kimi-k3",
          "options": {
            "reasoningEffort": "max",
            "textVerbosity": "low"
          },
          "cost": {
            "input": 3,
            "output": 15,
            "cache_read": 0.3
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1000000,
            "output": 48000
          },
          "variants": {
            "low": {"reasoningEffort": "low"},
            "high": {"reasoningEffort": "high"},
            "max": {"reasoningEffort": "max"}
          }
        },
        "glm-5.3": {
          "name": "GLM 5.3",
          "family": "glm",
          "options": {
            "reasoningEffort": "max",
            "textVerbosity": "low"
          },
          "cost": {
            "input": 1.4,
            "output": 4.4,
            "cache_read": 0.26,
            "cache_write": 0
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 1000000,
            "output": 64000
          },
          "variants": {
            "low": {"reasoningEffort": "low"},
            "high": {"reasoningEffort": "high"},
            "max": {"reasoningEffort": "max"}
          }
        },
        "qwen3.8-27b": {
          "name": "Qwen 3.8 27B",
          "family": "qwen",
          "options": {
            "reasoningEffort": "xhigh",
            "textVerbosity": "low"
          },
          "cost": {
            "input": 0.45,
            "output": 3.2,
            "cache_read": 0.05,
            "cache_write": 0.5625
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 256000,
            "output": 32000
          },
          "variants": {
            "low": {"reasoningEffort": "low"},
            "medium": {"reasoningEffort": "medium"},
            "xhigh": {"reasoningEffort": "xhigh"}
          }
        },
        "qwen3.8-flash-next": {
          "name": "Qwen 3.8 Flash",
          "family": "qwen",
          "options": {
            "reasoningEffort": "xhigh",
            "textVerbosity": "low"
          },
          "cost": {
            "input": 0.15,
            "output": 0.47,
            "cache_read": 0.016,
            "cache_write": 0.2
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 256000,
            "output": 48000
          },
          "variants": {
            "low": {"reasoningEffort": "low"},
            "medium": {"reasoningEffort": "medium"},
            "xhigh": {"reasoningEffort": "xhigh"}
          }
        }
      }
    }
  }
}
